[Unit]
Description=Codemao course presentations
After=network.target

[Service]
Type=simple
User=courseplan
Group=courseplan
WorkingDirectory=/srv/course-plans/current
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=CIRCLE_NODE_TOTAL=1
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3100
Restart=on-failure
RestartSec=5
MemoryHigh=600M
MemoryMax=800M
CPUQuota=100%
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
